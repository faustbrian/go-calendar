        "package_selection": {
          "github.com/faustbrian/go-calendar/v2": "Use for immutable civil dates, typed calendar periods, Gregorian arithmetic, and explicit calendar policies.",
          "github.com/faustbrian/go-calendar/v2/adapters/clock": "Use to derive civil dates from an explicitly supplied narrow wall-clock capability.",
          "github.com/faustbrian/go-calendar/v2/adapters/config": "Use for strict configuration-value decoding of canonical civil dates.",
          "github.com/faustbrian/go-calendar/v2/adapters/postgres": "Use for database/sql and pgx PostgreSQL date and infinity mappings.",
          "github.com/faustbrian/go-calendar/v2/adapters/temporal": "Use to convert civil date ranges into bounded sequences and explicit instant boundaries.",
          "github.com/faustbrian/go-calendar/v2/adapters/validation": "Use for dependency-neutral civil-date validation rules.",
          "github.com/faustbrian/go-calendar/v2/adapters/wire": "Use for the bounded versioned JSON representation of civil dates.",
          "github.com/faustbrian/go-calendar/v2/business": "Use for immutable, revisioned holiday and business-day policy with explicit search bounds.",
          "github.com/faustbrian/go-calendar/v2/calendarclock": "Deprecated compatibility path for the clock adapter; use adapters/clock.",
          "github.com/faustbrian/go-calendar/v2/calendarconfig": "Deprecated compatibility path for the configuration adapter; use adapters/config.",
          "github.com/faustbrian/go-calendar/v2/calendartemporal": "Deprecated compatibility path for temporal conversion; use adapters/temporal.",
          "github.com/faustbrian/go-calendar/v2/calendartest": "Use in tests for deterministic clock, date, and timezone transition fixtures and assertions.",
          "github.com/faustbrian/go-calendar/v2/calendarvalidation": "Deprecated compatibility path for date validation; use adapters/validation.",
          "github.com/faustbrian/go-calendar/v2/calendarwire": "Deprecated compatibility path for date wire encoding; use adapters/wire.",
          "github.com/faustbrian/go-calendar/v2/postgres": "Deprecated compatibility path for PostgreSQL date mappings; use adapters/postgres.",
          "github.com/faustbrian/go-calendar/v2/timezone": "Use for explicit IANA timezone loading and deterministic local-time gap and fold resolution."
